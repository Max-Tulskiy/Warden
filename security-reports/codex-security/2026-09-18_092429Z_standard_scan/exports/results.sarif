            "confidence": "high",
            "findingId": "csf_90d36bf2b9a619b64bca3b53",
            "occurrenceId": "occ_27e6506f48a14e6308e911dd",
            "severity": "medium"
          },
          "ruleId": "auth.login-throttling-audit",
          "ruleIndex": 0
        },
