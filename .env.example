# Copy to .env and fill in before `docker compose up`. Never commit the real
# .env file (already covered by .gitignore).

POSTGRES_USER=warden
POSTGRES_PASSWORD=change-me
POSTGRES_DB=warden

# A long, random value -- signs operator JWTs (constitution principle 5).
WARDEN_JWT_SECRET=change-me-to-a-long-random-value

# Created on first startup if no operator exists yet (services/bootstrap.py).
# Change the password after first login; unset both once you have done so.
WARDEN_SEED_ADMIN_USERNAME=admin
WARDEN_SEED_ADMIN_PASSWORD=change-me

# The domain Caddy issues a certificate for. "localhost" (the default) gets
# a Caddy-internal self-signed certificate, fine for local use; set this to
# a real hostname before exposing the deployment beyond your own machine.
WARDEN_DOMAIN=localhost
