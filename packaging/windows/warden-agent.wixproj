<Project Sdk="WixToolset.Sdk/5.0.0">
  <PropertyGroup>
    <OutputName>warden-agent</OutputName>
    <OutputType>Package</OutputType>
    <!--
      Product.wxs installs under ProgramFiles64Folder and ships a 64-bit
      frozen agent; a package left at the default x86 platform has 32-bit
      components in a 64-bit directory, which ICE80 validation refuses.
    -->
    <InstallerPlatform>x64</InstallerPlatform>
    <!--
      The installer has a wizard, and its standard pages come in the language of
      the package: Russian (constitution principle 9). Product.wxs sets
      Language="1049" to match.
    -->
    <Cultures>ru-RU</Cultures>
  </PropertyGroup>

  <!--
    A property given as -p:Name=value is only an MSBuild property. Product.wxs
    reads $(var.Name), a WiX preprocessor variable, and those come from
    DefineConstants alone, so each value is handed over here by name. The
    two file paths are made absolute against this project's directory, so
    they do not depend on which directory the WiX tools resolve them from.
  -->
  <PropertyGroup>
    <WardenAgentExeFullPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(WardenAgentExePath)'))</WardenAgentExeFullPath>
    <WardenConfigExampleFullPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(WardenConfigExamplePath)'))</WardenConfigExampleFullPath>
    <WardenConfiguratorDirFullPath>$([MSBuild]::NormalizePath('$(MSBuildProjectDirectory)', '$(WardenConfiguratorDirPath)'))</WardenConfiguratorDirFullPath>
    <DefineConstants>$(DefineConstants);WardenVersion=$(WardenVersion);WardenAgentExePath=$(WardenAgentExeFullPath);WardenConfigExamplePath=$(WardenConfigExampleFullPath);WardenConfiguratorDirPath=$(WardenConfiguratorDirFullPath)</DefineConstants>
  </PropertyGroup>

  <!--
    Product.wxs is not listed as a Compile item: the WiX SDK already takes
    every *.wxs under the project directory, and a second entry compiles
    the same package twice ("Multiple entry sections").
  -->

  <ItemGroup>
    <PackageReference Include="WixToolset.UI.wixext" Version="5.0.0" />
    <PackageReference Include="WixToolset.Util.wixext" Version="5.0.0" />
  </ItemGroup>

  <!--
    WardenVersion/WardenAgentExePath/WardenConfigExamplePath/WardenConfiguratorDirPath
    (the folder the frozen connection window was built into) are passed on
    the command line by release.yml (`dotnet build -p:WardenVersion=...`),
    derived from the release tag, not hardcoded here, so this project
    file does not need editing for every release.
  -->
</Project>
