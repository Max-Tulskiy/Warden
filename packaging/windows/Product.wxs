<?xml version="1.0" encoding="utf-8"?>
<!--
  WiX v4/v5 source for the Windows agent installer.

  Untested on a real Windows machine as of this writing, written and only
  checked by reading against the WiX v4 schema and documentation, the same
  boundary the constitution's Section VI records for every Windows-only
  piece of this project. The first real build and install happens in
  release.yml's windows-latest job; a manual install/uninstall/upgrade
  cycle on a real Windows 10/11 machine before shipping a release is a
  separate, tracked step (specs/001-agent-server-complex/tasks.md).

  ServiceInstall points at warden-agent.exe, which release.yml freezes from
  warden_agent/service/windows.py (the pywin32 ServiceFramework entry
  point), not warden_agent/__main__.py, which is a plain blocking CLI that
  does not speak the Windows Service Control Manager's protocol at all.

  The connection window is a second program, warden-agent-config.exe, frozen
  from warden_agent/configurator/windows.py as a folder (Qt's libraries stay
  separate, replaceable files) and installed under Configurator\. The wizard
  page in ConnectionUI.wxs collects SERVER_URL, ENROLLMENT_TOKEN and
  SERVER_CA_SHA256; the same properties can be given to a silent install. The
  deferred action ApplyConnection hands them to the window's command line,
  which enrolls the station; its result is ignored, so a station that could
  not be connected is still installed, and the window finishes the job.
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
    Name="Warden Agent"
    Manufacturer="Warden project"
    Language="1049"
    Version="$(var.WardenVersion)"
    UpgradeCode="8f3d3f7a-6c3b-4b0e-9f7a-2c1e6b6b6f9a">

    <MajorUpgrade DowngradeErrorMessage="A newer version of Warden Agent is already installed." />
    <MediaTemplate EmbedCab="yes" />

    <!--
      What the wizard collects, and what a silent install may be given:
      msiexec /i warden-agent.msi /qn SERVER_URL=... ENROLLMENT_TOKEN=...
      SERVER_CA_SHA256=... All three are secure, so they reach the elevated
      part of the install from a non-elevated msiexec; the token is also
      hidden, so a verbose installer log does not print it.
    -->
    <Property Id="SERVER_URL" Secure="yes" />
    <Property Id="ENROLLMENT_TOKEN" Secure="yes" Hidden="yes" />
    <Property Id="SERVER_CA_SHA256" Secure="yes" />

    <!--
      Enrolls the station after the files are in place and before the service
      starts, so the service comes up already configured. Deferred and not
      impersonated: it writes into a folder only SYSTEM and Administrators may
      touch. The values are resolved into the command line when the action is
      scheduled. Return="ignore": a failed connection never fails the
      installation; the window is where it is finished. Skipped on an upgrade
      and a repair, which must not ask about or change the connection.
    -->
    <CustomAction
      Id="ApplyConnection"
      FileRef="WardenAgentConfigExe"
      ExeCommand="--apply --replace --no-restart --server &quot;[SERVER_URL]&quot; --token &quot;[ENROLLMENT_TOKEN]&quot; --ca-sha256 &quot;[SERVER_CA_SHA256]&quot;"
      Execute="deferred"
      Impersonate="no"
      Return="ignore" />

    <!-- Opens the window from the wizard's last page, as the installing user. -->
    <CustomAction
      Id="LaunchConfigurator"
      FileRef="WardenAgentConfigExe"
      ExeCommand=""
      Execute="immediate"
      Impersonate="yes"
      Return="asyncNoWait" />

    <InstallExecuteSequence>
      <Custom
        Action="ApplyConnection"
        After="InstallFiles"
        Condition="NOT Installed AND NOT WIX_UPGRADE_DETECTED AND SERVER_URL &lt;&gt; &quot;&quot;" />
    </InstallExecuteSequence>

    <UIRef Id="WixUI_Warden" />

    <StandardDirectory Id="ProgramFiles64Folder">
      <Directory Id="INSTALLFOLDER" Name="Warden Agent">
        <Component Id="ServiceExecutable" Guid="2d6a9b8e-5b7a-4a3f-9e0a-1c4b8f2a7d3e">
          <File Id="WardenAgentExe" Source="$(var.WardenAgentExePath)" KeyPath="yes" />

          <ServiceInstall
            Id="WardenAgentServiceInstall"
            Name="WardenAgent"
            DisplayName="Warden Insider-Activity Monitoring Agent"
            Description="Observes hardware/software inventory, removable media, printing, processes, and browsing history; reports on request from the Warden server."
            Type="ownProcess"
            Start="auto"
            ErrorControl="normal"
            Account="LocalSystem" />

          <ServiceControl
            Id="WardenAgentServiceControl"
            Name="WardenAgent"
            Start="install"
            Stop="both"
            Remove="uninstall" />
        </Component>

        <Component Id="ThirdPartyNotices" Guid="4b0c2f6d-7a5e-4d13-9a8b-6e2d1c9f3a70">
          <File Id="ThirdPartyNoticesTxt" Source="THIRD-PARTY-NOTICES.txt" KeyPath="yes" />
        </Component>

        <Directory Id="ConfiguratorFolder" Name="Configurator">
          <!--
            The frozen window is a folder, not one file: the Qt libraries stay
            separate files that can be replaced (PySide6 is LGPLv3), and nothing
            is unpacked into %TEMP% at every start. The executable is declared
            on its own, since the shortcut and the actions above refer to it;
            everything else beside it is taken as it is.
          -->
          <Component Id="ConfiguratorExecutable" Guid="c3a7e9d1-5b2f-4e68-8d40-1f9a6b7c2e85">
            <File Id="WardenAgentConfigExe" Source="$(var.WardenConfiguratorDirPath)/warden-agent-config.exe" KeyPath="yes" />
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="ProgramMenuFolder">
      <Directory Id="WardenMenuFolder" Name="Warden">
        <Component Id="ConfiguratorShortcut" Guid="e5d1b8a2-9c4f-4a76-b3e0-2a8f7d6c1b94">
          <!-- The executable asks for elevation, so opening this shows the UAC prompt. -->
          <Shortcut
            Id="ConfiguratorStartMenuShortcut"
            Name="Warden Agent — настройка"
            Description="Подключение станции к серверу Warden"
            Target="[#WardenAgentConfigExe]"
            WorkingDirectory="ConfiguratorFolder" />
          <RemoveFolder Id="RemoveWardenMenuFolder" On="uninstall" />
          <RegistryValue Root="HKLM" Key="Software\Warden\Agent" Name="ConfiguratorShortcut" Type="integer" Value="1" KeyPath="yes" />
        </Component>
      </Directory>
    </StandardDirectory>

    <StandardDirectory Id="CommonAppDataFolder">
      <Directory Id="WardenAppDataFolder" Name="Warden">
        <Directory Id="AgentAppDataFolder" Name="agent">
          <!--
            This directory holds everything the agent keeps: the config,
            which carries a live one-time enrollment token until the
            operator removes it, and the state file with the agent's own
            key, written by the service after enrollment (CWE-732, Codex
            Security 2026-09-18). Under %ProgramData% ordinary Users would
            inherit read access, so the directory gets a protected DACL
            ("D:P", nothing inherited from above) granting full control to
            SYSTEM (SY) and Administrators (BA) only, and everything the
            service creates in it inherits that (OICI).

            The rights are given by well-known SID in SDDL, through Windows
            Installer's own MsiLockPermissionsEx, rather than by account
            name: an account name such as "SYSTEM" or "Administrators" is
            localized on a Russian Windows, and a name the installer cannot
            resolve aborts the installation.

            Unverified on a real Windows machine, like the rest of this
            installer; see the file-level comment above.
          -->
          <Component Id="AgentDataFolder" Guid="a7c8ca87-2670-4457-822c-5c173fc0b53d">
            <CreateFolder>
              <PermissionEx Sddl="D:P(A;OICI;FA;;;SY)(A;OICI;FA;;;BA)" />
            </CreateFolder>
          </Component>

          <!--
            NeverOverwrite: an upgrade must not clobber a config an
            administrator has already filled in with a real server_url and
            enrollment_token (or, after first enrollment, that no longer
            even needs enrollment_token at all). The file carries the same
            protected DACL as its directory, set on it directly so it does
            not depend on the order in which the two are applied.
          -->
          <Component Id="DefaultConfig" Guid="6b8e2a1f-3c4d-4e9a-8f1b-9a2d6e5c7b3a" NeverOverwrite="yes">
            <File
              Id="ConfigToml"
              Source="$(var.WardenConfigExamplePath)"
              Name="config.toml"
              KeyPath="yes">
              <PermissionEx Sddl="D:P(A;;FA;;;SY)(A;;FA;;;BA)" />
            </File>
          </Component>
        </Directory>
      </Directory>
    </StandardDirectory>

    <!-- Everything beside the executable in the frozen window's folder. -->
    <ComponentGroup Id="ConfiguratorFiles" Directory="ConfiguratorFolder">
      <Files Include="$(var.WardenConfiguratorDirPath)/**">
        <Exclude Files="$(var.WardenConfiguratorDirPath)/warden-agent-config.exe" />
      </Files>
    </ComponentGroup>

    <Feature Id="MainFeature" Title="Warden Agent" Level="1">
      <ComponentRef Id="ServiceExecutable" />
      <ComponentRef Id="ThirdPartyNotices" />
      <ComponentRef Id="ConfiguratorExecutable" />
      <ComponentRef Id="ConfiguratorShortcut" />
      <ComponentGroupRef Id="ConfiguratorFiles" />
      <ComponentRef Id="AgentDataFolder" />
      <ComponentRef Id="DefaultConfig" />
    </Feature>
  </Package>
</Wix>
